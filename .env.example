SURE_API_URL=http://localhost:3000
SURE_API_KEY=
SURE_ACCESS_TOKEN=
SURE_REFRESH_TOKEN=
SURE_TIMEOUT=30
# SURE_VERIFY_SSL=false
SURE_VERIFY_SSL=true

# MCP transport: stdio, sse, or streamable-http (default: streamable-http)
MCP_TRANSPORT=streamable-http
# Host/port/path only apply to sse and streamable-http transports.
MCP_HOST=0.0.0.0
MCP_PORT=8000
MCP_PATH=/mcp
